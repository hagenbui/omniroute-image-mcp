# Copy to image.env, chmod 600 image.env, and edit locally. Never commit image.env.
export OMNIROUTE_IMAGE_API_KEY='replace-with-your-dedicated-image-key'
# Works only with a local tunnel forwarding to your OmniRoute server.
export OMNIROUTE_IMAGE_BASE_URL='http://127.0.0.1:20129/v1'
export OMNIROUTE_IMAGE_MODEL='codex/gpt-5.6-sol'
export OMNIROUTE_IMAGE_OUTPUT_DIR="$HOME/Library/Application Support/openai-image-mcp/images"
export OMNIROUTE_IMAGE_TIMEOUT_SECONDS='600'
export MCP_TOOL_TIMEOUT='660000'
